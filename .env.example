# Required. Copy the Cookie header value from GLaDOS / Railgun after login.
# Multiple accounts can be joined with &: cookie1&cookie2
GLADOS_COOKIES="koa:sess=...; koa:sess.sig=...;"

# Optional: plan100, plan200, or plan500. Default is plan500.
GLADOS_EXCHANGE_PLAN="plan500"

# Optional: PushDeer send key for mobile notifications.
PUSHDEER_SENDKEY=""

# Optional: true/false. Enables detailed response logs.
GLADOS_VERBOSE="false"
